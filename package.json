{
  "name": "wizpay-core",
  "description": "Institutional-grade task execution engine for batched USDC payroll on Arc.",
  "author": "DeSeti (WizPay)",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@10.9.7",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev:stack": "docker compose up --build",
    "dev:backend": "npm run start:dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "build": "npm run build -w backend && npm run build -w frontend && npm run build -w wizpay_router",
    "lint": "npm run lint -w backend && npm run lint -w frontend",
    "test": "npm run test:backend && npm run test:contracts",
    "test:backend": "npm run test -w backend",
    "test:contracts": "npm run test -w wizpay_router"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "@coinbase/cdp-sdk": "1.48.2",
    "axios": "1.20.0",
    "firebase": "12.19.0",
    "multer": "2.4.0",
    "next": "16.3.5",
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.22.0",
    "postcss": "8.5.28",
    "protobufjs": "7.6.5",
    "sharp": "0.35.4",
    "toml": "4.2.0",
    "undici": "6.28.1",
    "viem": "2.45.3",
    "websocket-driver": "0.7.5",
    "ws": "8.21.3",
    "jsdom": {
      "undici": "7.24.5"
    }
  }
}
