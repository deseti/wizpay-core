# syntax=docker/dockerfile:1.7

FROM node:22-alpine AS workspace-deps

WORKDIR /repo

COPY package.json package-lock.json ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY packages/bridge-registry/package.json ./packages/bridge-registry/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
RUN --mount=type=cache,id=wizpay-npm-v1,target=/root/.npm,sharing=locked \
    set -eu; attempt=1; \
    while :; do \
      if npm ci --legacy-peer-deps --no-audit --no-fund --prefer-offline \
        > /tmp/npm-ci.log 2>&1; then \
        cat /tmp/npm-ci.log; break; \
      fi; \
      cat /tmp/npm-ci.log; \
      if [ "$attempt" -ge 2 ] || \
        ! grep -Eq 'ECONNRESET|ETIMEDOUT|EAI_AGAIN|ERR_SOCKET|npm error network' /tmp/npm-ci.log; then \
        exit 1; \
      fi; \
      attempt=2; \
      echo 'npm ci hit a transient network failure; retrying once.'; \
    done

FROM workspace-deps AS builder

ENV NEXT_TELEMETRY_DISABLED=1

COPY apps/frontend ./apps/frontend
COPY packages/bridge-registry ./packages/bridge-registry

# ── Build-time env vars ───────────────────────────────────────────────────────
# Each ARG receives its value from docker-compose build.args (which reads from
# root .env). The ENV lines bake the values into the Next.js bundle so they are
# available as process.env.NEXT_PUBLIC_* in browser code.
#
# To add a new public var: add ARG + ENV here AND in docker-compose build.args
# AND in the root .env file.
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ARG NEXT_PUBLIC_BACKEND_API_BASE_URL=http://localhost:4000
ARG NEXT_PUBLIC_BACKEND_URL=
ARG NEXT_PUBLIC_WIZPAY_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_INVOICE_API_PREFIX=
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ARG NEXT_PUBLIC_CIRCLE_APP_ID=
ARG NEXT_PUBLIC_CIRCLE_KIT_KEY=
ARG NEXT_PUBLIC_CIRCLE_PASSKEY_CLIENT_KEY=
ARG NEXT_PUBLIC_CIRCLE_PASSKEY_CLIENT_URL=
ARG NEXT_PUBLIC_CIRCLE_PASSKEY_MODULAR_RPC_URL_ARC_TESTNET=
ARG NEXT_PUBLIC_CIRCLE_PASSKEY_MODULAR_RPC_URL_ETH_SEPOLIA=
ARG NEXT_PUBLIC_CIRCLE_PASSKEY_RP_ID=app.wizpay.xyz
ARG NEXT_PUBLIC_RPC_URL=https://rpc.testnet.arc.io
ARG NEXT_PUBLIC_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARG NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL=
ARG NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URL=
ARG NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URLS=
ARG NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARG NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARG NEXT_PUBLIC_OP_SEPOLIA_RPC_URL=https://sepolia.optimism.io
ARG NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
ARG NEXT_PUBLIC_USE_REAL_STABLEFX=false
ARG NEXT_PUBLIC_CIRCLE_API_PROXY_ENABLED=false
ARG NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
ARG NEXT_PUBLIC_ARC_USDC=
ARG NEXT_PUBLIC_WIZPAY_SWAP_EXECUTOR_V2_ADDRESS=
ARG NEXT_PUBLIC_CONTRACT_ADDRESS=
ARG NEXT_PUBLIC_WIZPAY_ADDRESS=
ARG NEXT_PUBLIC_WIZPAY_AGENTIC_NANO_ADDRESS=

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_BACKEND_API_BASE_URL=$NEXT_PUBLIC_BACKEND_API_BASE_URL
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_WIZPAY_PUBLIC_APP_URL=$NEXT_PUBLIC_WIZPAY_PUBLIC_APP_URL
ENV NEXT_PUBLIC_INVOICE_API_PREFIX=$NEXT_PUBLIC_INVOICE_API_PREFIX
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_CIRCLE_APP_ID=$NEXT_PUBLIC_CIRCLE_APP_ID
ENV NEXT_PUBLIC_CIRCLE_KIT_KEY=$NEXT_PUBLIC_CIRCLE_KIT_KEY
ENV NEXT_PUBLIC_CIRCLE_PASSKEY_CLIENT_KEY=$NEXT_PUBLIC_CIRCLE_PASSKEY_CLIENT_KEY
ENV NEXT_PUBLIC_CIRCLE_PASSKEY_CLIENT_URL=$NEXT_PUBLIC_CIRCLE_PASSKEY_CLIENT_URL
ENV NEXT_PUBLIC_CIRCLE_PASSKEY_MODULAR_RPC_URL_ARC_TESTNET=$NEXT_PUBLIC_CIRCLE_PASSKEY_MODULAR_RPC_URL_ARC_TESTNET
ENV NEXT_PUBLIC_CIRCLE_PASSKEY_MODULAR_RPC_URL_ETH_SEPOLIA=$NEXT_PUBLIC_CIRCLE_PASSKEY_MODULAR_RPC_URL_ETH_SEPOLIA
ENV NEXT_PUBLIC_CIRCLE_PASSKEY_RP_ID=$NEXT_PUBLIC_CIRCLE_PASSKEY_RP_ID
ENV NEXT_PUBLIC_RPC_URL=$NEXT_PUBLIC_RPC_URL
ENV NEXT_PUBLIC_ARC_TESTNET_RPC_URL=$NEXT_PUBLIC_ARC_TESTNET_RPC_URL
ENV NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL=$NEXT_PUBLIC_ARC_MAINNET_EXPLORER_URL
ENV NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URL=$NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URL
ENV NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URLS=$NEXT_PUBLIC_ETHEREUM_SEPOLIA_RPC_URLS
ENV NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=$NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL
ENV NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL=$NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL
ENV NEXT_PUBLIC_OP_SEPOLIA_RPC_URL=$NEXT_PUBLIC_OP_SEPOLIA_RPC_URL
ENV NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=$NEXT_PUBLIC_MONAD_TESTNET_RPC_URL
ENV NEXT_PUBLIC_USE_REAL_STABLEFX=$NEXT_PUBLIC_USE_REAL_STABLEFX
ENV NEXT_PUBLIC_CIRCLE_API_PROXY_ENABLED=$NEXT_PUBLIC_CIRCLE_API_PROXY_ENABLED
ENV NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
ENV NEXT_PUBLIC_ARC_USDC=$NEXT_PUBLIC_ARC_USDC
ENV NEXT_PUBLIC_WIZPAY_SWAP_EXECUTOR_V2_ADDRESS=$NEXT_PUBLIC_WIZPAY_SWAP_EXECUTOR_V2_ADDRESS
ENV NEXT_PUBLIC_CONTRACT_ADDRESS=$NEXT_PUBLIC_CONTRACT_ADDRESS
ENV NEXT_PUBLIC_WIZPAY_ADDRESS=$NEXT_PUBLIC_WIZPAY_ADDRESS
ENV NEXT_PUBLIC_WIZPAY_AGENTIC_NANO_ADDRESS=$NEXT_PUBLIC_WIZPAY_AGENTIC_NANO_ADDRESS

RUN npm run build -w frontend

FROM node:22-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

COPY --chown=node:node --from=builder /repo/apps/frontend/.next/standalone ./
COPY --chown=node:node --from=builder /repo/apps/frontend/.next/static ./.next/static
COPY --chown=node:node --from=builder /repo/apps/frontend/public ./public
# React is a workspace root development dependency and is not always traced
# into Next's standalone output when the app is built from the monorepo root.
COPY --chown=node:node --from=builder /repo/node_modules/react ./node_modules/react
COPY --chown=node:node --from=builder /repo/node_modules/react-dom ./node_modules/react-dom

USER node

EXPOSE 3000

CMD ["node", "server.js"]
