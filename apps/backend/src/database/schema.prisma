generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id                  String               @id @default(uuid()) @db.Uuid
  type                String
  status              String
  totalUnits          Int                  @default(0)
  completedUnits      Int                  @default(0)
  failedUnits         Int                  @default(0)
  metadata            Json?
  payload             Json
  result              Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  logs                TaskLog[]
  units               TaskUnit[]
  transactions        TaskTransaction[]
  payrollFxOperations PayrollFxOperation[]
  payrollFxPayoutPlan PayrollFxPayoutPlan?
}

enum PayrollFxExecutionProvider {
  STABLEFX @map("stablefx")
  SWAPKIT  @map("swapkit")
}

enum PayrollFxWalletMode {
  APP @map("app")
}

enum PayrollFxOperationStatus {
  CREATED
  QUOTE_PENDING
  QUOTE_READY
  APPROVAL_PENDING
  SUBMITTED
  FUNDING_PENDING
  SETTLEMENT_PENDING
  SETTLED
  PAYOUT_PENDING
  COMPLETED
  RECOVERY_REQUIRED
  FAILED
}

model PayrollFxOperation {
  operationId                     String                     @id @default(uuid()) @db.Uuid
  idempotencyKey                  String                     @unique
  taskId                          String?                    @db.Uuid
  walletMode                      PayrollFxWalletMode
  executionProvider               PayrollFxExecutionProvider
  sourceTokenAddress              String
  destinationTokenAddress         String
  sourceTokenSymbol               String
  destinationTokenSymbol          String
  network                         String
  sourceWalletAddress             String
  treasuryWalletAddress           String
  amountInBaseUnits               String
  requestedMinimumOutputBaseUnits String?
  status                          PayrollFxOperationStatus   @default(CREATED)
  failureCode                     String?
  failureMessage                  String?
  quoteId                         String?
  quoteExpiresAt                  DateTime?
  expectedOutputBaseUnits         String?
  actualOutputBaseUnits           String?
  providerOperationId             String?
  approvalTransactionId           String?
  approvalTransactionHash         String?
  fundingTransactionId            String?
  fundingTransactionHash          String?
  settlementTransactionId         String?
  settlementTransactionHash       String?
  payoutTransactionId             String?
  payoutTransactionHash           String?
  approvalTargetAddress           String?
  lastProviderStatus              String?
  diagnosticSnapshot              Json?
  executionLeaseId                String?
  executionLeaseExpiresAt         DateTime?
  executionAttemptCount           Int                        @default(0)
  lastAttemptStartedAt            DateTime?
  lastAttemptFinishedAt           DateTime?
  recoveryFromStatus              PayrollFxOperationStatus?
  submittedAt                     DateTime?
  fundingConfirmedAt              DateTime?
  settledAt                       DateTime?
  payoutConfirmedAt               DateTime?
  completedAt                     DateTime?
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  task                            Task?                      @relation(fields: [taskId], references: [id], onDelete: Restrict)
  payoutPlan                      PayrollFxPayoutPlan?

  @@unique([taskId])
  @@index([executionProvider, providerOperationId])
  @@index([status, failureCode])
  @@index([executionLeaseExpiresAt])
}

enum PayrollFxPayoutPlanStatus {
  PLANNED
}

enum PayrollFxPayoutAllocationStatus {
  PLANNED
}

model PayrollFxPayoutPlan {
  id                            String                      @id @default(uuid()) @db.Uuid
  operationId                   String                      @unique @db.Uuid
  taskId                        String                      @unique @db.Uuid
  executionProvider             PayrollFxExecutionProvider
  network                       String
  tokenAddress                  String
  tokenDecimals                 Int
  sourceWalletAddress           String
  settledBudgetBaseUnits        String
  totalRequestedWeightBaseUnits String
  totalAllocatedBaseUnits       String
  dustBaseUnits                 String
  allocationAlgorithmVersion    String
  immutableInputHash            String                      @unique
  status                        PayrollFxPayoutPlanStatus   @default(PLANNED)
  createdAt                     DateTime                    @default(now())
  operation                     PayrollFxOperation          @relation(fields: [operationId], references: [operationId], onDelete: Restrict)
  task                          Task                        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  allocations                   PayrollFxPayoutAllocation[]
}

model PayrollFxPayoutAllocation {
  id                       String                          @id @default(uuid()) @db.Uuid
  planId                   String                          @db.Uuid
  recipientLineId          String
  recipientIndex           Int
  recipientAddress         String
  destinationTokenAddress  String
  requestedWeightBaseUnits String
  allocatedAmountBaseUnits String
  deterministicRank        Int
  status                   PayrollFxPayoutAllocationStatus @default(PLANNED)
  createdAt                DateTime                        @default(now())
  plan                     PayrollFxPayoutPlan             @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, recipientLineId])
  @@unique([planId, recipientIndex])
  @@index([planId, deterministicRank])
}

model TaskLog {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  level     String   @default("INFO")
  step      String
  status    String
  message   String
  context   Json?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model TaskUnit {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  type      String
  index     Int
  status    String   @default("PENDING")
  txHash    String?
  error     String?
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, id])
  @@unique([taskId, index])
  @@index([taskId])
}

/// Tracks individual on-chain transactions within a task.
/// Each payroll recipient gets one TaskTransaction record.
model TaskTransaction {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @db.Uuid
  /// Circle transaction ID
  txId         String
  /// Recipient address
  recipient    String
  /// Human-readable amount
  amount       String
  /// Token symbol (USDC, EURC)
  currency     String
  /// pending | completed | failed
  status       String   @default("pending")
  /// On-chain tx hash (null until confirmed)
  txHash       String?
  /// Error reason (only for failed transactions)
  errorReason  String?
  /// Batch index within the payroll
  batchIndex   Int      @default(0)
  /// Number of poll attempts made
  pollAttempts Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  task         Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([txId])
  @@index([taskId, status])
}

model UserWallet {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String
  userEmail   String?
  chain       String
  blockchain  String
  walletId    String   @unique
  address     String
  walletSetId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, blockchain])
  @@index([userId])
  @@index([userId, chain])
}

model AppWalletSwapOperation {
  operationId                String    @id @db.Uuid
  operationMode              String
  sourceChain                String
  tokenIn                    String
  tokenOut                   String
  amountIn                   String
  userWalletAddress          String
  treasuryDepositAddress     String
  expectedOutput             Json?
  minimumOutput              Json?
  expiresAt                  String
  status                     String
  executionProvider          String?
  quoteId                    Json?
  rawQuote                   Json?
  depositTxHash              String?
  circleTransactionId        String?
  circleReferenceId          String?
  circleWalletId             String?
  depositSubmittedAt         DateTime?
  depositConfirmedAt         DateTime?
  depositConfirmedAmount     String?
  depositConfirmationError   String?
  executionEnabled           Boolean   @default(false)
  treasurySwapId             String?
  treasurySwapQuoteId        String?
  treasurySwapTxHash         String?
  treasurySwapSubmittedAt    DateTime?
  treasurySwapConfirmedAt    DateTime?
  treasurySwapExpectedOutput Json?
  treasurySwapActualOutput   String?
  rawTreasurySwap            Json?
  stablefxFundingRequestedAt DateTime?
  stablefxFundedAt           DateTime?
  payoutTxHash               String?
  payoutAmount               String?
  payoutSubmittedAt          DateTime?
  payoutConfirmedAt          DateTime?
  rawPayout                  Json?
  refundTransactionId        String?
  refundTxHash               String?
  refundAmount               String?
  refundSubmittedAt          DateTime?
  refundConfirmedAt          DateTime?
  rawRefund                  Json?
  executionLeaseId           String?
  executionLeaseExpiresAt    DateTime?
  completedAt                DateTime?
  executionError             String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  @@index([status])
  @@index([circleTransactionId])
  @@index([circleReferenceId])
  @@index([depositTxHash])
  @@index([treasurySwapId])
  @@index([treasurySwapTxHash])
  @@index([payoutTxHash])
  @@index([refundTransactionId])
  @@index([refundTxHash])
  @@index([executionLeaseExpiresAt])
}

model BridgeTransaction {
  id        String   @id @default(uuid())
  taskId    String   @unique
  status    String
  payload   Json
  result    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
