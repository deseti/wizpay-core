{
  "name": "backend",
  "version": "0.0.1",
  "description": "NestJS task orchestrator for WizPay payroll, FX, bridge, and liquidity execution.",
  "author": "DeSeti (WizPay)",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rm -f tsconfig.build.tsbuildinfo dist/tsconfig.build.tsbuildinfo",
    "prestart:dev": "rm -f tsconfig.build.tsbuildinfo dist/tsconfig.build.tsbuildinfo",
    "build": "nest build",
    "prisma:generate": "prisma generate --schema src/database/schema.prisma",
    "prisma:push": "node -e \"throw new Error('Use an explicit network-scoped Prisma command.')\"",
    "prisma:push:arc-mainnet": "WIZPAY_ARC_NETWORK=arc-mainnet WIZPAY_MIGRATION_NETWORK=arc-mainnet prisma db push --schema src/database/schema.prisma",
    "prisma:migrate:arc-mainnet": "WIZPAY_ARC_NETWORK=arc-mainnet WIZPAY_MIGRATION_NETWORK=arc-mainnet prisma migrate deploy --schema src/database/schema.prisma",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:phase7:offline": "jest --runInBand src/phase7/phase7-offline-rehearsal.postgres.spec.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.4",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.2.4",
    "@nestjs/platform-express": "11.2.4",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@wizpay/arc-network": "file:../../packages/arc-network",
    "@wizpay/bridge-registry": "file:../../packages/bridge-registry",
    "bullmq": "^5.76.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "ioredis": "^5.10.1",
    "pg": "^8.16.3",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "viem": "2.45.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "fast-check": "^3.23.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "overrides": {
    "axios": "1.20.0",
    "deepmerge-ts": "8.0.0",
    "multer": "2.4.0",
    "mysql2": "3.22.0",
    "protobufjs": "7.6.5",
    "toml": "4.2.0",
    "undici": "6.28.1",
    "viem": "2.45.3",
    "ws": "8.21.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "schema": "src/database/schema.prisma"
  }
}
